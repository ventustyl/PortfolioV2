@page "/Error"
@using System.Diagnostics

<PageTitle>Une erreur est survenue — Eric Venturino</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<main class="utility-page">
    <a class="utility-brand" href="/" aria-label="Retour à l'accueil d'Eric Venturino">
        <span>EV</span>
        <strong>Eric Venturino</strong>
    </a>

    <div class="utility-content">
        <p class="utility-eyebrow">Erreur / 500</p>
        <span class="utility-code" aria-hidden="true">500</span>
        <h1>Un imprévu s’est glissé<br /><em>dans le code.</em></h1>
        <p>La page n’a pas pu être affichée. Vous pouvez revenir à l’accueil et reprendre votre visite.</p>
        @if (ShowRequestId)
        {
            <p class="request-id">Référence : <code>@RequestId</code></p>
        }
        <a class="button button-primary" href="/">
            Revenir à l’accueil
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
    </div>
</main>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
